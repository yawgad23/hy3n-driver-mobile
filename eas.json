{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://europe-west1-hy3n26.cloudfunctions.net/api",
        "EXPO_PUBLIC_DAILY_COMMISSION_AMOUNT": "0.11"
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://europe-west1-hy3n26.cloudfunctions.net/api",
        "EXPO_PUBLIC_DAILY_COMMISSION_AMOUNT": "0.11"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://europe-west1-hy3n26.cloudfunctions.net/api",
        "EXPO_PUBLIC_DAILY_COMMISSION_AMOUNT": "50"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "nanayawgad23@gmail.com",
        "appleTeamId": "49Q5ZSPMZ9",
        "ascAppId": "6798016192"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "production"
      }
    }
  }
}
